CONTACT_EMAIL=support@acquisiflow.com

# Contact form delivery (https://resend.com)
RESEND_API_KEY=
CONTACT_FROM=AcquisiFlow <onboarding@resend.dev>

# Production canonical URLs are fixed in lib/site.ts.
# Set true on non-Vercel staging builds only; leave false/unset in production.
SITE_NOINDEX=false
# Public verification tokens, not API keys. Configure before building.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

INDEXNOW_KEY=